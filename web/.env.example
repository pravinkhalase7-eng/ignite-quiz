# Same Postgres server as AI Teacher. Tables are quiz_users, quiz_quizzes, and quiz_history.
# On the VPS the container is aiteacher-postgres. URL-encode # in the password as %23.
DATABASE_URL=postgresql://aiteacher:change-me@aiteacher-postgres:5432/aiteacher

# Google OAuth client. Add this exact redirect URI in Google Cloud:
# http://quiz.doxstation.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://quiz.doxstation.com
